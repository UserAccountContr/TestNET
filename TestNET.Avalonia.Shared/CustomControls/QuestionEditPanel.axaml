<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:TestNET.Avalonia.Shared.CustomControls"
        xmlns:serv="using:TestNET.Avalonia.Shared.Service"
        xmlns:model="clr-namespace:TestNET.Avalonia.Shared.Model">
    <Design.PreviewWith>
        <controls:QuestionEditPanel />
    </Design.PreviewWith>
    <Styles.Resources>
        <serv:MultiBindConverter x:Key="MultiConv"/>
    </Styles.Resources>

    <Style Selector="controls|QuestionEditPanel[QType=SH]">
        <!-- Set Defaults -->
        <Setter Property="Template">
            <ControlTemplate>
                <controls:QuestionPanel 
                    QuestionIndex="{TemplateBinding QuestionIndex}"
                    ShowDropdown="True">
                    <controls:QuestionPanel.DropdownContent>
                        <StackPanel Background="White">
                            <Button Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource delete}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveUpQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource moveup}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveDownQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource movedown}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </controls:QuestionPanel.DropdownContent>

                    <StackPanel Margin="15">
                        <controls:LatexTextBox IsMath="{Binding QuestionSH.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="{Binding QuestionSH.Text, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0 0 0 15"/>
                        <controls:LatexTextBox IsMath="{Binding QuestionSH.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="{Binding QuestionSH.Answer.Text, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <WrapPanel HorizontalAlignment="Right">
                            <CheckBox Content="{DynamicResource math}" IsChecked="{Binding QuestionSH.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                      FontSize="14"
                                      Margin="0 0 40 0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>

                            <!-- Text="{Binding QuestionSH.Points, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, RelativeSource={RelativeSource TemplatedParent}}" -->
                            <NumericUpDown FontSize="14"
                                     MinWidth="30"
                                     VerticalContentAlignment="Center"
                                     Value="{Binding QuestionSH.Points, RelativeSource={RelativeSource TemplatedParent}}"
                                     Minimum="0"/>
                            <Label Content="{DynamicResource pointsFull}"
                                   Theme="{DynamicResource MediumLabel}"/>

                        </WrapPanel>
                    </StackPanel>
                </controls:QuestionPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="controls|QuestionEditPanel[QType=MC]">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:QuestionPanel QuestionIndex="{TemplateBinding QuestionIndex}"
                             ShowDropdown="True">
                    <controls:QuestionPanel.DropdownContent>
                        <StackPanel>
                            <Button Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource delete}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveUpQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource moveup}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveDownQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource movedown}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </controls:QuestionPanel.DropdownContent>
                    <StackPanel Margin="15">
                        <controls:LatexTextBox IsMath="{Binding QuestionMC.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="{Binding QuestionMC.Text, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0 0 0 15"/>

                        <ItemsControl ItemsSource="{Binding QuestionMC.PossibleAnswers, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:Answer}">
                                    <WrapPanel HorizontalAlignment="Stretch" Background="Transparent">
                                        <RadioButton GroupName="{Binding QuestionMC.UniqueId, RelativeSource={RelativeSource AncestorType=controls:QuestionEditPanel}}"
                                                     IsChecked="{Binding IsCorrect, Mode=TwoWay}" 
                                                     VerticalAlignment="Stretch"
                                                     VerticalContentAlignment="Center"/>
                                        <controls:LatexTextBox Text="{Binding Text}" 
                                                            IsMath="{Binding QuestionMC.TextIsMath, RelativeSource={RelativeSource AncestorType=controls:QuestionEditPanel}}"/>
                                        <WrapPanel VerticalAlignment="Center"
                                                   Margin="5 0">
                                            <WrapPanel.Theme>
                                                <ControlTheme TargetType="WrapPanel">
                                                    <Style Selector="^:pointerover">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </ControlTheme>
                                            </WrapPanel.Theme>
                                            <Button Command="{Binding DataContext.RemAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMC" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding DataContext.MoveUpAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMC" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding DataContext.MoveDownAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMC" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                        </WrapPanel>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0 1"/>
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                                    <!--StringFormat="+ {0}"-->
                            <Button Content="{DynamicResource addposans}"
                                    Grid.Column="0"
                                    Command="{Binding DataContext.AddPosAnsToQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding QuestionMC, RelativeSource={RelativeSource TemplatedParent}}" 
                                    Margin="15 5"/>
                            
                            <WrapPanel HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Grid.Column="1">

                                <CheckBox Content="{DynamicResource math}" IsChecked="{Binding QuestionMC.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                      FontSize="14"
                                      Margin="0 0 40 0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                                <NumericUpDown FontSize="14"
                                         MinWidth="30"
                                         Minimum="0"
                                         Value="{Binding QuestionMC.Points, RelativeSource={RelativeSource TemplatedParent}}"
                                         VerticalContentAlignment="Center"/>
                                <Label Content="{DynamicResource pointsFull}"
                                       Theme="{DynamicResource MediumLabel}"/>

                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </controls:QuestionPanel>
            </ControlTemplate>
        </Setter>
    </Style>
    
    <Style Selector="controls|QuestionEditPanel[QType=MCM]">
        <Setter Property="Template">
            <ControlTemplate>
                <controls:QuestionPanel QuestionIndex="{TemplateBinding QuestionIndex}"
                             ShowDropdown="True">
                    <controls:QuestionPanel.DropdownContent>
                        <StackPanel>
                            <Button Command="{Binding DataContext.RemoveQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource delete}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveUpQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource moveup}"
