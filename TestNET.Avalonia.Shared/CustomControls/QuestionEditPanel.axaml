                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>

                            <Button Command="{Binding DataContext.MoveDownQuestionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{TemplateBinding Question}" Background="White">
                                <Grid HorizontalAlignment="Stretch">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Height="16"
                                             Grid.Column="0">
                                        <Path Data="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
                                                  Fill="Black"
                                                  Stretch="Fill"/>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{DynamicResource movedown}"
                                               VerticalAlignment="Center"
                                               Padding="10 0 0 0"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </controls:QuestionPanel.DropdownContent>
                    <StackPanel Margin="15">
                        <controls:LatexTextBox IsMath="{Binding QuestionMCM.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                            Text="{Binding QuestionMCM.Text, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0 0 0 15"/>

                        <ItemsControl ItemsSource="{Binding QuestionMCM.PossibleAnswers, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type model:Answer}">
                                    <WrapPanel HorizontalAlignment="Stretch" Background="Transparent">
                                        <CheckBox IsChecked="{Binding IsCorrect, Mode=TwoWay}" 
                                                  VerticalAlignment="Stretch"
                                                  VerticalContentAlignment="Center"/>
                                        <controls:LatexTextBox Text="{Binding Text}" 
                                                            IsMath="{Binding QuestionMCM.TextIsMath, RelativeSource={RelativeSource AncestorType=controls:QuestionEditPanel}}"/>
                                        <WrapPanel VerticalAlignment="Center"
                                                   Margin="5 0">
                                            <WrapPanel.Theme>
                                                <ControlTheme TargetType="WrapPanel">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                    <Style Selector="^:pointerover">
                                                        <Setter Property="IsVisible" Value="True"/>
                                                    </Style>
                                                </ControlTheme>
                                            </WrapPanel.Theme>
                                            <Button Command="{Binding DataContext.RemAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMCM" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M280-120q-33 0-56.5-23.5T200-200v-520h-40v-80h200v-40h240v40h200v80h-40v520q0 33-23.5 56.5T680-120H280Zm400-600H280v520h400v-520ZM360-280h80v-360h-80v360Zm160 0h80v-360h-80v360ZM280-720v520-520Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding DataContext.MoveUpAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMCM" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M440-160v-487L216-423l-56-57 320-320 320 320-56 57-224-224v487h-80Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                            <Button Command="{Binding DataContext.MoveDownAnsFromQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    Padding="2"
                                                    Margin="2 0"
                                                    Height="20">
                                                <Button.CommandParameter>
                                                    <MultiBinding Converter="{StaticResource MultiConv}">
                                                        <Binding Path="QuestionMCM" RelativeSource="{RelativeSource AncestorType=controls:QuestionEditPanel}"/>
                                                        <Binding Path="."/>
                                                    </MultiBinding>
                                                </Button.CommandParameter>
                                                <Grid>
                                                    <Viewbox>
                                                        <Path Data="M440-800v487L216-537l-56 57 320 320 320-320-56-57-224 224v-487h-80Z"
                                                          Fill="Black"
                                                          Stretch="Fill"/>
                                                    </Viewbox>
                                                </Grid>
                                            </Button>
                                        </WrapPanel>
                                    </WrapPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemContainerTheme>
                                <ControlTheme TargetType="ContentPresenter">
                                    <Setter Property="Margin" Value="0 1"/>
                                </ControlTheme>
                            </ItemsControl.ItemContainerTheme>
                        </ItemsControl>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                                    <!--ContentStringFormat="+ {0}"-->
                            <Button Content="{DynamicResource addposans}"
                                    Grid.Column="0"
                                    Command="{Binding DataContext.AddPosAnsToQCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding QuestionMCM, RelativeSource={RelativeSource TemplatedParent}}" 
                                    Margin="15 5"/>

                            <WrapPanel HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Grid.Column="1">

                                <CheckBox Content="{DynamicResource math}" IsChecked="{Binding QuestionMCM.TextIsMath, RelativeSource={RelativeSource TemplatedParent}}"
                                      FontSize="14"
                                      Margin="0 0 40 0"
                                      VerticalAlignment="Center"
                                      VerticalContentAlignment="Center"/>
                                <NumericUpDown FontSize="14"
                                         MinWidth="30"
                                         Value="{Binding QuestionMCM.Points, RelativeSource={RelativeSource TemplatedParent}}"
                                         VerticalContentAlignment="Center"/>
                                <Label Content="{DynamicResource pointsFull}"
                                       Theme="{DynamicResource MediumLabel}"/>

                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </controls:QuestionPanel>
            </ControlTemplate>
        </Setter>
    </Style>
</Styles>
