<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:vm="clr-namespace:TestNET.Avalonia.Student.ViewModels"
             xmlns:sharedserv="clr-namespace:TestNET.Avalonia.Shared.Service;assembly=TestNET.Avalonia.Shared"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TestNET.Avalonia.Student.Views.HomeView"
             x:DataType="vm:HomeViewModel">

	<Design.DataContext>
		<vm:HomeViewModel/>
	</Design.DataContext>
    
	<Border Theme="{DynamicResource BorderSt}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">
        <StackPanel Width="500"
                    Margin="20">
            <Label Content="TestNET" 
                   FontSize="40"
                   Margin="0 0 0 30"
                   HorizontalAlignment="Center"/>
            <Label Content="{DynamicResource fname}"
                   Theme="{DynamicResource MediumLabel}"/>
            <TextBox
                Text="{Binding FirstName, Mode=TwoWay}"
                Watermark="{DynamicResource fname}"
                IsEnabled="{Binding IsNotGettingTest}"
                FontSize="14"
                Margin="0 0 0 5"/>

            <Label Content="{DynamicResource lname}"
                   Theme="{StaticResource MediumLabel}"/>
            <TextBox 
                Text="{Binding LastName, Mode=TwoWay}"
                Watermark="{DynamicResource lname}"
                IsEnabled="{Binding IsNotGettingTest}"
                FontSize="14"
                Margin="0 0 0 5"/>

            <Label Content="Review password"
                   Theme="{StaticResource MediumLabel}"
                   IsVisible="{Binding RevMode}"/>
            <TextBox 
                Text="{Binding RevPass, Mode=TwoWay}"
                Watermark="{DynamicResource revpw}"
                IsEnabled="{Binding IsNotGettingTest}"
                FontSize="14"
                Margin="0 0 0 5"
                IsVisible="{Binding RevMode}"/>

            <Label Content="{DynamicResource testcode}"
                   Theme="{StaticResource MediumLabel}"/>
            <TextBox 
                Text="{Binding Code, Mode=TwoWay}"
                Watermark="{DynamicResource testcode}"
                IsEnabled="{Binding IsNotGettingTest}"
                FontSize="14"
                Margin="0 0 0 20"/>


            <Button Content="Get test"
                    Command="{Binding GoToTestOverviewCommand}"
                    IsEnabled="{Binding CanStart}"
                    Background="White"
                    Margin="190 0"
                    Padding="10"
                    IsVisible="{Binding NotRevMode}">
                <Button.Resources>
                    <sharedserv:MultiBindConverter x:Key="Conv"/>
                </Button.Resources>
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource Conv}">
                        <Binding Path="FullName"/>
                        <Binding Path="Code"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>


            <Button Content="Review test"
                    Command="{Binding GoToSubmReviewCommand}"
                    IsEnabled="{Binding CanStartReview}"
                    Background="White"
                    Margin="190 0"
                    Padding="10"
                    IsVisible="{Binding RevMode}">
                <Button.Resources>
                    <sharedserv:MultiBindConverter x:Key="Conv"/>
                </Button.Resources>
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource Conv}">
                        <Binding Path="FullName"/>
                        <Binding Path="Code"/>
                        <Binding Path="RevPass"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>

            <Grid>
                <WrapPanel HorizontalAlignment="Right"
                           IsVisible="{Binding NotRevMode}">
                    <Label Content="Review submission"
                           Theme="{StaticResource MediumLabel}"/>
                    <Button Content="&gt;"
                            Padding="7 0"
                            Background="White"
                            IsEnabled="{Binding IsNotGettingTest}"
                            Command="{Binding EnableRevModeCommand}"/>
                </WrapPanel>

                <WrapPanel HorizontalAlignment="Left"
                           IsVisible="{Binding RevMode}">
                    <Button Content="&lt;"
                            Padding="7 0"
                            Background="White"
                            IsEnabled="{Binding IsNotGettingTest}"
                            Command="{Binding DisableRevModeCommand}"/>
                    <Label Content="Cancel Review"
                           Theme="{StaticResource MediumLabel}"/>
                </WrapPanel>
            </Grid>
            
        </StackPanel>
    </Border>
</UserControl>
